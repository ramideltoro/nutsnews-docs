flowchart TD
  accTitle: Privacy selection and responsive navigation flow
  accDescr {
    Readers choose an Android or iOS privacy policy at the privacy selector. On narrow screens, a top-left menu provides the public navigation links; the desktop footer keeps those links.
  }
  privacy["/privacy selector"] --> android["Android policy: /privacy/android"]
  privacy --> ios["iOS policy: /privacy/ios"]
  viewport{"Viewport below 720px?"}
  viewport -- Yes --> menu["Fixed top-left hamburger menu"]
  menu --> links["Apps · Saved · About · Contact · Privacy"]
  viewport -- No --> footer["Desktop footer keeps navigation links"]
  menu -. Escape, outside pointer, or link selection .-> closed["Menu closes; Escape returns focus to toggle"]
