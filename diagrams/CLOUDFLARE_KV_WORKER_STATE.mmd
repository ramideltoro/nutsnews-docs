flowchart TD
  accTitle: Cloudflare KV Worker State for NutsNews
  accDescr {
    This update adds an optional Cloudflare Workers KV binding named NUTSNEWS_KV to the RSS shard Workers.
  }
  A["Create KV namespace `NUTSNEWS_KV`"] --> B["Set NUTSNEWS_KV_NAMESPACE_ID"]
  B --> C["Generate shard wrangler config"]
  C --> D["Deploy shards with optional KV binding"]
  D --> E["Shard request starts"] 
  E --> F["Read compact per-shard URL hash cache"]
  F -->|cache miss| G["Supabase processed-url lookup"]
  F -->|cache hit| H["Skip Supabase URL lookup for this article"]
  G --> I["Review decision writes back to Supabase"]
  I --> J["Write compact URL hash cache in KV"]
  D --> K["Write latest shard run + last successful run to KV"]
  K --> L["Expose `/kv-status` with kvEnabled/shard run fields"]
  L --> M["Read `/public-feed-snapshot` when feed changed"]
  M --> N["Skip unchanged KV writes"]
  O["Runtime safeguards"] --> P["Track KV op counts in memory"]
  O --> Q["Skip unchanged or idle writes"]
  O --> R["Rate-limit misses are tolerated as cache misses"]
