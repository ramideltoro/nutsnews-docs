---
title: NutsNews architecture and worker-uplift target
---

flowchart TD
  accTitle: Architecture
  accDescr {
    This is the current NutsNews architecture and the approved worker-uplift target
  }
  subgraph Current["Current production"]
    rss["RSS / Atom sources"] --> controller["Cloudflare legacy controller+shards"]
    controller --> supabase["Supabase primary"]
    supabase --> snapshot["public_feed_snapshot"]
    snapshot --> web["Next.js apps (Vercel)"]
    controller --> kv["Cloudflare KV fallback"]
    kv --> web
  end

  subgraph Target["Worker-uplift target"]
    scheduler["scheduler"] --> fetcher["fetcher"]
    fetcher --> canonicalizer["canonicalizer"]
    canonicalizer --> enrichment["enrichment"]
    enrichment --> approval["approval"]
    approval --> translation["translation"]
    translation --> persistence["persistence"]
    persistence --> publication["publication"]
    publication --> pg["Backend PostgreSQL (future primary)"]
  end

  supabase --> legacyReader["legacy reader/admin path"]
  legacyReader --> web
  pg --> web
  web --> operators["Operators and admins"]
  operators --> observability["Backend Alloy + Grafana"]
  observability --> pg
