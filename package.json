{
  "private": true,
  "name": "nutsnews-docs-wiki",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/**/*.test.mjs",
    "test:e2e": "playwright test",
    "dev": "astro dev",
    "build": "npm run wiki:prepare && astro build",
    "preview": "astro preview",
    "wiki:prepare": "node scripts/wiki/generate-wiki-content.mjs",
    "wiki:prepare:strict": "node scripts/wiki/generate-wiki-content.mjs --strict",
    "wiki:ensure-mermaid-accessibility": "node scripts/wiki/ensure-mermaid-accessibility.mjs",
    "validate:contracts": "node scripts/wiki/validate-wiki-contracts.mjs",
    "validate:links": "node scripts/wiki/validate-link-routes.mjs",
    "validate:mermaid": "node scripts/wiki/validate-mermaid-diagrams.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.51.0",
    "playwright": "^1.51.0"
  },
  "dependencies": {
    "mermaid": "^11.0.0",
    "@astrojs/starlight": "^0.41.4",
    "astro": "^7.1.3",
    "gray-matter": "^4.0.3"
  }
}
