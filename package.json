{
  "private": true,
  "name": "nutsnews-docs-wiki",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run wiki:prepare && npm run validate:content && astro build",
    "preview": "astro preview",
    "docs:prepare": "node scripts/wiki/docs-prepare.mjs",
    "docs:approve": "node scripts/wiki/docs-approve.mjs",
    "docs:new": "node scripts/wiki/docs-new.mjs",
    "test:docs-prepare": "node --test scripts/wiki/docs-prepare.test.mjs",
    "test:wiki-approvals": "node --test scripts/wiki/wiki-approval.test.mjs",
    "test:docs-new": "node --test scripts/wiki/docs-new.test.mjs",
    "test:content-contract": "node --test scripts/wiki/wiki-content-contract.test.mjs",
    "test:content-routes": "node --test scripts/wiki/wiki-content-routes.test.mjs",
    "test:pages-artifact": "node --test scripts/wiki/wiki-pages-artifact.test.mjs",
    "test:workflow": "node --test scripts/wiki/wiki-workflow.test.mjs",
    "test:browser": "playwright test",
    "test:browser:update": "playwright test --update-snapshots",
    "wiki:prepare": "node scripts/wiki/generate-wiki-content.mjs",
    "wiki:prepare:strict": "node scripts/wiki/generate-wiki-content.mjs --strict",
    "wiki:release:stamp": "node scripts/wiki/stamp-wiki-release.mjs",
    "wiki:diagrams:a11y": "npm run wiki:prepare && node scripts/wiki/add-mermaid-accessibility.mjs",
    "validate:contracts": "node scripts/wiki/validate-wiki-contracts.mjs",
    "validate:content": "node scripts/wiki/validate-wiki-content.mjs",
    "validate:inventory": "node scripts/wiki/validate-wiki-inventory.mjs",
    "validate:audiences": "npm run build && node scripts/wiki/validate-audience-routes.mjs",
    "validate:brand": "node scripts/wiki/validate-wiki-brand.mjs",
    "validate:links": "node scripts/wiki/validate-link-routes.mjs",
    "validate:mermaid": "node scripts/wiki/validate-mermaid-diagrams.mjs",
    "validate:pages-artifact": "node scripts/wiki/validate-pages-artifact.mjs",
    "validate:resolver": "node scripts/wiki/validate-root-resolver.mjs",
    "validate:article": "node scripts/wiki/validate-article-layout.mjs",
    "validate:audience-switch": "node scripts/wiki/validate-audience-switch.mjs",
    "validate:search": "node scripts/wiki/validate-pagefind-search.mjs",
    "validate:source-metadata": "node scripts/wiki/validate-source-metadata.mjs",
    "validate:approvals": "npm run wiki:prepare && node scripts/wiki/validate-wiki-approvals.mjs",
    "validate:routing": "node scripts/wiki/validate-static-routing.mjs",
    "validate:shell": "node scripts/wiki/validate-wiki-shell.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/starlight": "^0.41.4",
    "@pagefind/default-ui": "^1.5.2",
    "astro": "^7.1.3",
    "gray-matter": "^4.0.3",
    "mermaid": "^11.16.0",
    "openai": "^7.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "jsdom": "^28.1.0"
  }
}
