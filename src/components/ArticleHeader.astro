---
import { promises as fs } from 'node:fs';
import path from 'node:path';
import {
  historyGroupForSource,
  wikiContract,
} from '../../scripts/wiki/wiki-contract.mjs';

const { data } = Astro.locals.starlightRoute.entry;
const audience = data.audience
  || (Astro.url.pathname === '/technical/' || Astro.url.pathname.startsWith('/technical/')
    ? 'technical'
    : 'simple');
const audienceLabel = audience === 'technical' ? 'Technical' : 'Simple';
const section = data.section || wikiContract.defaults.section;
const sectionConfig = wikiContract.navigation.rail.find((item) => item.id === section);
const sectionLabel = sectionConfig?.label || 'Overview';
const title = data.title;
const description = data.description;
const diagramPath = data.diagram;
const isArticle = !String(data.source_path || '').startsWith('virtual:');
const historyGroup = historyGroupForSource(data.source_path);
const pageStatus = historyGroup
  ? 'Historical'
  : `${data.status || wikiContract.defaults.status}`.replace(
    /^./,
    (character) => character.toUpperCase(),
  );
const diagramRoot = path.resolve(process.cwd(), wikiContract.paths.diagramRoot);
const resolvedDiagramPath = path.resolve(process.cwd(), diagramPath);

if (
  isArticle
  && resolvedDiagramPath !== diagramRoot
  && !resolvedDiagramPath.startsWith(`${diagramRoot}${path.sep}`)
) {
  throw new Error(`Article diagram must be inside ${wikiContract.paths.diagramRoot}: ${diagramPath}`);
}

const diagramSource = isArticle ? await fs.readFile(resolvedDiagramPath, 'utf8') : '';
const base = import.meta.env.BASE_URL || '/';
const basePrefix = base === '/' ? '' : `/${base.replace(/^\/+|\/+$/g, '')}`;
const withBase = (route) => `${basePrefix}${route.startsWith('/') ? route : `/${route}`}`;
---

<nav class="article-breadcrumbs" aria-label="Breadcrumb">
  <ol>
    <li><a href={withBase(`/${audience}/`)}>{audienceLabel}</a></li>
    <li>
      <a href={withBase(`/${audience}/collections/${section}/`)}>{sectionLabel}</a>
    </li>
    <li aria-current="page">{title}</li>
  </ol>
</nav>

<header class="article-header" data-article-header>
  <p class="article-kicker">{audienceLabel} guide · {sectionLabel}</p>
  <p class="article-status" data-page-status={pageStatus.toLowerCase()}>
    <span>Page status: {pageStatus}</span>
    {historyGroup && <span>History group: {historyGroup.label}</span>}
  </p>
  <h1 id="_top">{title}</h1>
  <p class="article-description">{description}</p>
</header>

{
  isArticle && (
    <section
      class="diagram-slot"
      aria-labelledby="primary-diagram-title"
      data-wiki-diagram-slot
      data-diagram-source-path={diagramPath}
    >
      <div class="diagram-slot-heading">
        <div>
          <p class="diagram-kicker">Visual overview</p>
          <h2 id="primary-diagram-title">Primary diagram</h2>
        </div>
        <span class="diagram-status">System map</span>
      </div>
      <diagram-renderer data-diagram-title={`${title} system map`}>
        <div class="diagram-stage" data-wiki-diagram-stage>
          <div class="diagram-placeholder" aria-hidden="true">
            <span></span>
            <i></i>
            <span></span>
            <i></i>
            <span></span>
          </div>
          <p>Render the repository-owned system map when you need it.</p>
        </div>
        <div class="diagram-actions">
          <button type="button" data-render-diagram>Render diagram</button>
          <p data-diagram-status aria-live="polite">Diagram is not rendered yet.</p>
        </div>
        <details class="diagram-source" data-diagram-fallback data-pagefind-ignore>
          <summary>View diagram text</summary>
          <pre data-wiki-mermaid-source><code>{diagramSource}</code></pre>
        </details>
      </diagram-renderer>
    </section>
  )
}

<script>
  class DiagramRenderer extends HTMLElement {
    constructor() {
      super();
      const button = this.querySelector<HTMLButtonElement>('[data-render-diagram]');
      const stage = this.querySelector<HTMLElement>('[data-wiki-diagram-stage]');
      const status = this.querySelector<HTMLElement>('[data-diagram-status]');
      const fallback = this.querySelector<HTMLDetailsElement>('[data-diagram-fallback]');
      const source = this.querySelector<HTMLElement>('[data-wiki-mermaid-source] code');

      if (!button || !stage || !status || !fallback || !source) return;

      button.addEventListener('click', async () => {
        button.disabled = true;
        button.textContent = 'Rendering…';
        status.textContent = 'Rendering the diagram locally.';

        try {
          const { default: mermaid } = await import('mermaid');
          const isLight = document.documentElement.dataset.theme === 'light';
          mermaid.initialize({
            startOnLoad: false,
            securityLevel: 'strict',
            suppressErrorRendering: true,
            theme: 'base',
            maxTextSize: 50_000,
            flowchart: { htmlLabels: false, useMaxWidth: true },
            themeVariables: isLight
              ? {
                  background: '#f7edd7',
                  primaryColor: '#fff9ea',
                  primaryTextColor: '#21140e',
                  primaryBorderColor: '#8a4b00',
                  lineColor: '#7a5540',
                  secondaryColor: '#e8d8ba',
                  tertiaryColor: '#f7edd7',
                  fontFamily: 'system-ui, sans-serif',
                }
              : {
                  background: '#21140e',
                  primaryColor: '#332116',
                  primaryTextColor: '#fff9ea',
                  primaryBorderColor: '#f6bd5a',
                  lineColor: '#cfb88f',
                  secondaryColor: '#4a3020',
                  tertiaryColor: '#21140e',
                  fontFamily: 'system-ui, sans-serif',
                },
          });

          const definition = source.textContent || '';
          await mermaid.parse(definition, { suppressErrors: false });
          const diagramId = `nutsnews-diagram-${Date.now().toString(36)}`;
          const { svg } = await mermaid.render(diagramId, definition);
          stage.innerHTML = svg;
          const renderedSvg = stage.querySelector('svg');
          renderedSvg?.setAttribute('role', 'img');
          renderedSvg?.setAttribute('aria-label', this.dataset.diagramTitle || 'System diagram');
          stage.toggleAttribute('data-rendered', true);
          button.textContent = 'Diagram rendered';
          status.textContent = 'Diagram rendered locally.';
        } catch (error) {
          console.error('Unable to render repository Mermaid diagram.', error);
          fallback.open = true;
          button.disabled = false;
          button.textContent = 'Try rendering again';
          status.textContent = 'Diagram could not be rendered. The text fallback is available below.';
        }
      });
    }
  }

  if (!customElements.get('diagram-renderer')) {
    customElements.define('diagram-renderer', DiagramRenderer);
  }
</script>

<style>
  @layer starlight.core {
    .article-breadcrumbs {
      color: var(--wiki-color-text-muted);
      font-size: var(--wiki-type-xs);
    }

    .article-breadcrumbs ol {
      display: flex;
      flex-wrap: wrap;
      gap: var(--wiki-space-2);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .article-breadcrumbs li {
      min-width: 0;
      overflow-wrap: anywhere;
    }

    .article-breadcrumbs li + li::before {
      margin-inline-end: var(--wiki-space-2);
      color: var(--wiki-color-border);
      content: "/";
    }

    .article-breadcrumbs a {
      color: var(--wiki-color-link);
      text-underline-offset: 0.18em;
    }

    .article-header {
      display: grid;
      gap: var(--wiki-space-3);
      margin-top: var(--wiki-space-5);
    }

    .article-kicker,
    .diagram-kicker {
      margin: 0;
      color: var(--wiki-color-text-muted);
      font-size: var(--wiki-type-xs);
      font-weight: 750;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .article-status {
      display: flex;
      flex-wrap: wrap;
      gap: var(--wiki-space-2);
      margin: 0;
      color: var(--wiki-color-text-muted);
      font-size: var(--wiki-type-xs);
      font-weight: 700;
    }

    .article-status span {
      padding: var(--wiki-space-1) var(--wiki-space-3);
      border: 1px solid var(--wiki-color-border);
      border-radius: 999px;
      background: var(--wiki-color-surface-raised);
    }

    .article-status[data-page-status='historical'] span:first-child {
      border-color: var(--wiki-color-control);
    }

    h1 {
      max-width: 18ch;
      margin: 0;
      color: var(--wiki-color-text);
      font-family: var(--wiki-font-display);
      font-size: var(--wiki-type-display);
      font-weight: 700;
      line-height: var(--wiki-leading-tight);
      overflow-wrap: anywhere;
    }

    .article-description {
      max-width: 68ch;
      margin: 0;
      color: var(--wiki-color-text-muted);
      font-size: var(--wiki-type-lg);
      line-height: 1.6;
      overflow-wrap: anywhere;
    }

    .diagram-slot {
      display: grid;
      gap: var(--wiki-space-4);
      margin-top: var(--wiki-space-6);
      padding: var(--wiki-space-5);
      border: 1px solid var(--wiki-diagram-border);
      border-radius: var(--wiki-radius-lg);
      background:
        radial-gradient(circle at 88% 12%, color-mix(in srgb, var(--wiki-diagram-accent) 16%, transparent), transparent 34%),
        var(--wiki-diagram-background);
      color: var(--wiki-diagram-text);
      overflow: clip;
    }

    .diagram-slot-heading {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: var(--wiki-space-4);
    }

    .diagram-slot h2 {
      margin: var(--wiki-space-1) 0 0;
      color: var(--wiki-diagram-text);
      font-size: var(--wiki-type-xl);
    }

    .diagram-status {
      flex: 0 0 auto;
      padding: var(--wiki-space-1) var(--wiki-space-3);
      border: 1px solid var(--wiki-diagram-border);
      border-radius: 999px;
      color: var(--wiki-diagram-text);
      font-size: var(--wiki-type-xs);
      font-weight: 700;
    }

    .diagram-stage {
      display: grid;
      place-items: center;
      gap: var(--wiki-space-4);
      min-height: 11rem;
      padding: var(--wiki-space-5);
      border: 1px dashed var(--wiki-diagram-edge);
      border-radius: var(--wiki-radius-md);
      background: var(--wiki-diagram-surface);
      text-align: center;
    }

    diagram-renderer {
      display: grid;
      gap: var(--wiki-space-3);
    }

    .diagram-stage p {
      max-width: 42ch;
      margin: 0;
      color: var(--wiki-diagram-text);
      font-size: var(--wiki-type-sm);
    }

    .diagram-stage[data-rendered] {
      display: block;
      overflow: auto;
      background: var(--wiki-diagram-background);
    }

    .diagram-stage[data-rendered] :global(svg) {
      display: block;
      width: 100%;
      max-width: 100%;
      height: auto;
      margin-inline: auto;
    }

    .diagram-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--wiki-space-3);
    }

    .diagram-actions button {
      min-height: var(--wiki-touch-target);
      border: 1px solid var(--wiki-diagram-border);
      border-radius: var(--wiki-radius-sm);
      padding-inline: var(--wiki-space-4);
      color: var(--wiki-color-control-text);
      background: var(--wiki-diagram-accent);
      font: inherit;
      font-size: var(--wiki-type-sm);
      font-weight: 750;
      cursor: pointer;
    }

    .diagram-actions button:disabled {
      cursor: wait;
      opacity: 0.75;
    }

    .diagram-actions button:focus-visible,
    .diagram-source summary:focus-visible {
      outline: var(--wiki-focus-ring-width) solid var(--wiki-color-focus);
      outline-offset: var(--wiki-focus-ring-offset);
    }

    .diagram-actions p {
      margin: 0;
      color: var(--wiki-diagram-text);
      font-size: var(--wiki-type-xs);
    }

    .diagram-source {
      border: 1px solid var(--wiki-diagram-edge);
      border-radius: var(--wiki-radius-sm);
      color: var(--wiki-diagram-text);
      background: var(--wiki-diagram-background);
    }

    .diagram-source summary {
      min-height: var(--wiki-touch-target);
      padding: var(--wiki-space-3);
      font-size: var(--wiki-type-sm);
      font-weight: 700;
      cursor: pointer;
    }

    .diagram-source pre {
      max-height: 20rem;
      margin: 0;
      border-top: 1px solid var(--wiki-diagram-edge);
      border-radius: 0 0 var(--wiki-radius-sm) var(--wiki-radius-sm);
      padding: var(--wiki-space-4);
      overflow: auto;
      color: var(--wiki-diagram-text);
      background: var(--wiki-diagram-surface);
      white-space: pre;
    }

    .diagram-placeholder {
      display: flex;
      align-items: center;
      justify-content: center;
      width: min(100%, 24rem);
    }

    .diagram-placeholder span {
      width: 3rem;
      height: 2rem;
      border: 2px solid var(--wiki-diagram-border);
      border-radius: var(--wiki-radius-sm);
      background: var(--wiki-diagram-background);
    }

    .diagram-placeholder i {
      flex: 1 1 2rem;
      height: 2px;
      background: var(--wiki-diagram-edge);
    }

    @media (max-width: 30rem) {
      .diagram-slot {
        padding: var(--wiki-space-4);
      }

      .diagram-slot-heading {
        align-items: stretch;
        flex-direction: column;
      }

      .diagram-status {
        align-self: flex-start;
      }

      .diagram-stage {
        min-height: 9rem;
        padding: var(--wiki-space-4);
      }
    }
  }
</style>
